# API mode: "mock" (default, fully local) or "real" (connects to VITE_API_BASE_URL)
VITE_API_MODE=mock

# Base URL used only when VITE_API_MODE=real
# Point this to the Flask backend (default port 5000)
VITE_API_BASE_URL=http://localhost:5000/api

# Never put secrets in VITE_* variables. Anything prefixed with VITE_ is shipped to the browser.
